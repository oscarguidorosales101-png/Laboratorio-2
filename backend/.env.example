# Puerto del servidor backend Express
PORT=3000

# Configuración de base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=restaurante_reservas

# URL alternativa de conexión (opcional)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/restaurante_reservas

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Zona horaria del restaurante (ej. America/Costa_Rica)
TZ=America/Costa_Rica
